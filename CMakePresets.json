                "SIMDLIB_BUILD_API_SSE42_TESTS": "ON",
                "SIMDLIB_BUILD_API_AVX2_TESTS": "ON",
                "SIMDLIB_BUILD_FMA_TESTS": "ON",
                "SIMDLIB_BUILD_BMI_TESTS": "ON",
