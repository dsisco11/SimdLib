            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "clang-debug-coverage",
            "displayName": "Clang Debug coverage",
            "description": "Independent native Clang Debug source-coverage fingerprint",
