        },
        {
            "name": "clang22-debug-asan-ubsan",
            "displayName": "Clang 22 Debug ASan and UBSan",
            "description": "Independent Linux x64 Clang AddressSanitizer and UndefinedBehaviorSanitizer fingerprint",
