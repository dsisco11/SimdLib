cmake_minimum_required(VERSION 3.31)

# Invoke the public wrapper on assembled objects and check observable boundaries.
set(arguments "-DOBJECT_FILE=${OBJECT_FILE}" "-DEXPECTED_SYMBOL=${EXPECTED_SYMBOL}"
    "-DOUTPUT_DIRECTORY=${OUTPUT_DIRECTORY}" "-DLLVM_OBJDUMP=${LLVM_OBJDUMP}"
    "-DLLVM_READOBJ=${LLVM_READOBJ}")
if(DEFINED CONSTANT_SYMBOL)
    list(APPEND arguments "-DCONSTANT_SYMBOLS=${CONSTANT_SYMBOL}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" ${arguments}
    -P "${CMAKE_CURRENT_LIST_DIR}/../../../cmake/codegen/ExtractFunction.cmake"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
file(WRITE "${OUTPUT_DIRECTORY}/harness.txt" "exit=${result}\n${stdout}${stderr}")
if(DEFINED EXPECTED_DIAGNOSTIC)
    if(result EQUAL 0 OR NOT "${stdout}${stderr}" MATCHES "${EXPECTED_DIAGNOSTIC}")
        message(FATAL_ERROR "Expected rejection '${EXPECTED_DIAGNOSTIC}': ${stdout}${stderr}")
    endif()
    if(EXISTS "${OUTPUT_DIRECTORY}/extraction.txt")
        message(FATAL_ERROR "Failed extraction retained a success receipt")
    endif()
    return()
endif()
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Adversarial extraction failed: ${stdout}${stderr}")
endif()
file(READ "${OUTPUT_DIRECTORY}/body.txt" body)
if(EXPECTED_SYMBOL STREQUAL "adversarial_primary")
    if(NOT body MATCHES "ret[^\n]*\n(.|\n)*adversarial_after" OR
            NOT body MATCHES "adversarial_opaque" OR body MATCHES "<adversarial_other>:")
        message(FATAL_ERROR "Interior block/relocation lost, or unrelated COFF function included")
    endif()
elseif(EXPECTED_SYMBOL STREQUAL "adversarial_padding")
    if(NOT body MATCHES "ret" OR body MATCHES "nop|<adversarial_next>:")
        message(FATAL_ERROR "ELF size failed to exclude padding or the next function")
    endif()
endif()
if(DEFINED CONSTANT_SYMBOL)
    file(READ "${OUTPUT_DIRECTORY}/constants.txt" constants)
    string(TOLOWER "${constants}" constants)
    if(CONSTANT_SYMBOL STREQUAL "constant_one")
        set(required "88776655 44332211")
        set(forbidden "11223344 55667788")
    else()
        set(required "11223344 55667788")
        set(forbidden "88776655 44332211")
    endif()
    if(NOT constants MATCHES "${required}" OR constants MATCHES "${forbidden}")
        message(FATAL_ERROR "Numeric section selection did not isolate the requested constant")
    endif()
endif()
