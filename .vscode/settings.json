    "testMate.cpp.discovery.loadOnStartup": true,
    "testMate.cpp.experimental.llvm-cov": {
        "enabled": true,
        "logpanel": true,
        "tag": "coverage",
        "allowExecutableConcurrentInvocations": false
    },
    "testMate.cpp.coverage.profile.default": "llvm-cov by TestMate C++"
