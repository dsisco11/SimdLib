{
    "cmake.cmakePath": "${env:LOCALAPPDATA}/Microsoft/WinGet/Links/cmake.exe",
    "cmake.useCMakePresets": "always",
    "cmake.configureOnOpen": true,
    "cmake.environment": {
        "PATH": "${env:ProgramFiles}/LLVM/bin;${env:ProgramFiles}/Microsoft Visual Studio/2022/Community/Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja;${env:PATH}"
    },
    "cmake.ctest.testExplorerIntegrationEnabled": true,
    "cmake.ctest.allowParallelJobs": true,
    "cmake.preRunCoverageTarget": "SimdLibCoverageReset",
    "cmake.postRunCoverageTarget": "SimdLibCoverageReport",
    "cmake.coverageInfoFiles": [
        "${workspaceFolder}/build-coverage/coverage.info"
    ]
}
